---
// Hand-drawn line art used across the site. Strokes follow the theme colours.
interface Props {
  name: 'attention' | 'web' | 'smart_surveillance' | 'medical_transcriptions' | 'rover' | 'doclit_ai' |'mug' | 'skyline' | 'wireframe';
  label: string;
  width?: number;
}
const { name, label, width } = Astro.props;
---

{name === 'attention' && (
  <svg class="doodle" viewBox="0 0 360 260" width={width ?? '100%'} role="img" aria-label={label}>
    <circle cx="60" cy="60" r="14" /><circle cx="60" cy="130" r="14" /><circle cx="60" cy="200" r="14" />
    <circle cx="180" cy="40" r="14" /><circle cx="180" cy="105" r="14" /><circle cx="180" cy="170" r="14" /><circle cx="180" cy="230" r="12" />
    <circle cx="300" cy="95" r="14" /><circle cx="300" cy="170" r="14" />
    <path d="M74 60 L166 40 M74 60 L166 105 M74 60 L166 170 M74 130 L166 40 M74 130 L166 105 M74 130 L166 170 M74 130 L168 230 M74 200 L166 105 M74 200 L166 170 M74 200 L168 230" />
    <path d="M194 40 L286 95 M194 105 L286 95 M194 105 L286 170 M194 170 L286 95 M194 170 L286 170 M192 230 L286 170" />
    <path class="accent draw" d="M60 44 C 110 -6, 250 -6, 300 79" stroke-dasharray="5 6" />
    <path class="accent" d="M292 70 L300 80 L306 68" />
  </svg>
)}

{name === 'web' && (
  <svg class="doodle" viewBox="0 0 220 150" width={width ?? 220} role="img" aria-label={label}>
    <rect x="40" y="10" width="100" height="130" rx="4" />
    <path d="M54 32 H126 M54 46 H118 M54 60 H126 M54 74 H108 M54 88 H126 M54 102 H114 M54 116 H96" />
    <path class="marker" d="M52 60 H128" />
    <path class="accent" d="M140 60 C 160 56, 166 46, 176 42" />
    <rect class="accent" x="176" y="30" width="36" height="22" rx="4" />
    <path class="accent" d="M140 102 C 160 104, 166 112, 176 116" />
    <rect class="accent" x="176" y="108" width="36" height="22" rx="4" />
  </svg>
)}

{name === 'smart_surveillance' && (
  <svg
    class="doodle"
    viewBox="0 0 240 150"
    width={width ?? 240}
    role="img"
    aria-label={label}
  >
    <!-- camera -->
    <rect x="24" y="42" width="62" height="42" rx="6" />
    <circle cx="55" cy="63" r="15" />
    <circle cx="55" cy="63" r="6" />

    <!-- camera mount -->
    <path d="M86 58 H104" />
    <path d="M94 58 V91 H78" />

    <!-- detection frame -->
    <rect class="accent" x="112" y="35" width="72" height="70" rx="4" />

    <!-- detected person -->
    <circle cx="148" cy="55" r="9" />
    <path d="M134 88 Q148 68 162 88" />

    <!-- detection corners -->
    <path class="accent" d="M112 48 V35 H125" />
    <path class="accent" d="M171 35 H184 V48" />
    <path class="accent" d="M112 92 V105 H125" />
    <path class="accent" d="M171 105 H184 V92" />

    <!-- alert -->
    <path class="accent" d="M196 48 L208 70 L196 92 L184 70 Z" />
    <path d="M196 59 V75" />
    <circle cx="196" cy="82" r="2" />

    <!-- dashboard / signal lines -->
    <path d="M24 108 H72" />
    <path d="M24 118 H58" />
    <path class="accent" d="M112 120 H160" />

    <!-- labels -->
    <text class="label" x="24" y="28">camera</text>
  </svg>
)}

{name === 'doclit_ai' && (
  <svg
    class="doodle"
    viewBox="0 0 240 150"
    width={width ?? 240}
    role="img"
    aria-label={label}
  >
    <!-- PDF document -->
    <path d="M22 22 L82 22 L96 36 L96 112 L22 112 Z" />
    <path d="M82 22 V37 H96" />

    <!-- PDF text -->
    <path d="M34 48 H78" />
    <path d="M34 59 H82" />
    <path d="M34 70 H72" />
    <path d="M34 81 H78" />

    <!-- search / retrieval -->
    <circle class="accent" cx="116" cy="67" r="18" />
    <circle cx="116" cy="67" r="9" />
    <path class="accent" d="M129 80 L140 91" />

    <!-- retrieved chunks -->
    <rect x="102" y="101" width="18" height="10" rx="2" />
    <rect x="126" y="101" width="18" height="10" rx="2" />
    <rect x="150" y="101" width="18" height="10" rx="2" />

    <!-- arrow to answer -->
    <path class="accent" d="M140 67 H162" />
    <path class="accent" d="M155 60 L163 67 L155 74" />

    <!-- AI answer bubble -->
    <path d="M164 30 H218 Q224 30 224 36 V72 Q224 78 218 78 H190 L180 88 V78 H170 Q164 78 164 72 Z" />

    <!-- answer text -->
    <path d="M174 45 H214" />
    <path d="M174 56 H207" />
    <path d="M174 67 H212" />

    <!-- labels -->
    {/* <text class="label" x="28" y="132">PDF</text> */}
    <text class="label" x="101" y="25">retrieve</text>
    {/* <text class="label" x="174" y="101">answer</text> */}
  </svg>
)}

{name === 'medical_transcriptions' && (
  <svg
    class="doodle"
    viewBox="0 0 240 150"
    width={width ?? 240}
    role="img"
    aria-label={label}
  >
    <!-- medical transcription document -->
    <path d="M22 20 L92 20 L92 116 L22 116 Z" />
    
    <!-- document lines -->
    <path d="M34 35 H78" />
    <path d="M34 46 H82" />
    <path d="M34 57 H70" />
    
    <!-- medical cross -->
    <path d="M48 72 V94 M37 83 H59" />
    
    <!-- transcription / audio waveform -->
    <path
      class="accent"
      d="M104 70
         L110 70
         L114 58
         L119 84
         L124 48
         L130 94
         L136 62
         L141 76
         L148 70"
    />

    <!-- arrow -->
    <path class="accent" d="M150 70 H170" />
    <path class="accent" d="M163 63 L171 70 L163 77" />

    <!-- NLP extracted information -->
    <rect x="178" y="38" width="42" height="68" rx="4" />
    <path d="M185 50 H213" />
    <path d="M185 61 H207" />
    <path d="M185 72 H213" />
    <path d="M185 83 H204" />

    <!-- extracted entity highlights -->
    <rect class="accent" x="184" y="91" width="12" height="7" rx="2" />
    <rect class="accent" x="200" y="91" width="14" height="7" rx="2" />

    <!-- labels -->
    <text class="label" x="28" y="132">medical transcription</text>
    <text class="label" x="177" y="28">NLP</text>
  </svg>
)}

{name === 'rover' && (
  <svg
    class="doodle"
    viewBox="0 0 220 150"
    width={width ?? 220}
    role="img"
    aria-label={label}
  >
    <!-- ultrasonic waves -->
    <path d="M174 55 Q195 65 174 75" fill="none" />
    <path d="M181 45 Q215 65 181 85" fill="none" />
    <path d="M188 35 Q230 65 188 95" fill="none" />

    <!-- rover chassis -->
    <rect x="45" y="65" width="115" height="42" rx="8" />

    <!-- top electronics -->
    <rect x="78" y="42" width="48" height="25" rx="4" />
    <path d="M87 51 H117 M87 58 H108" />

    <!-- HC-SR04 sensor -->
    <rect x="143" y="73" width="30" height="18" rx="3" />
    <circle cx="151" cy="82" r="5" />
    <circle cx="165" cy="82" r="5" />

    <!-- wheels -->
    <circle cx="62" cy="112" r="15" />
    <circle cx="142" cy="112" r="15" />

    <!-- wheel hubs -->
    <circle cx="62" cy="112" r="5" />
    <circle cx="142" cy="112" r="5" />

    <!-- connection lines -->
    <path d="M62 97 V88" stroke-dasharray="3 4" />
    <path d="M142 97 V88" stroke-dasharray="3 4" />

    <!-- label -->
    <text class="label" x="48" y="28">ultrasonic rover</text>
  </svg>
)}

{name === 'mug' && (
  <svg class="doodle thick" viewBox="0 0 160 160" width={width ?? 150} role="img" aria-label={label}>
    <path d="M38 64 H112 L106 132 Q104 142 94 142 H56 Q46 142 44 132 Z" />
    <path d="M112 78 Q136 80 132 100 Q128 116 108 114" />
    <path d="M60 52 Q52 40 62 30 Q70 20 62 10 M78 52 Q70 40 80 30 Q88 20 80 10 M96 52 Q88 40 98 30" />
  </svg>
)}

{name === 'skyline' && (
  <svg class="doodle thick" viewBox="0 0 200 160" width={width ?? 190} role="img" aria-label={label}>
    <path d="M10 110 V70 H34 V110 M34 110 V50 H58 V110 M58 110 V84 H80 V110 M80 110 V30 L94 18 L108 30 V110 M108 110 V62 H134 V110 M134 110 V76 H160 V110 M160 110 V56 H186 V110" />
    <path d="M6 110 H194" />
    <path d="M20 124 H60 M80 124 H140 M40 136 H100 M120 136 H170" stroke-dasharray="6 6" />
  </svg>
)}

{name === 'wireframe' && (
  <svg class="doodle thick" viewBox="0 0 180 160" width={width ?? 170} role="img" aria-label={label}>
    <rect x="20" y="14" width="72" height="132" rx="10" />
    <path d="M32 34 H80 M32 46 H66" />
    <rect x="32" y="58" width="48" height="36" rx="4" />
    <path d="M32 106 H80 M32 118 H72 M32 130 H60" />
    <path class="accent" d="M98 76 Q120 70 130 54" />
    <path class="accent" d="M124 56 L131 52 L132 61" />
    <text class="label" x="112" y="44">bigger?</text>
  </svg>
)}

<style>
  .doodle {
    display: block;
    height: auto;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .doodle.thick {
    stroke-width: 1.8;
  }
  .accent {
    stroke: var(--red);
  }
  .marker {
    stroke: #e8b923;
    stroke-width: 7;
    opacity: 0.6;
  }
  .label {
    fill: var(--red);
    stroke: none;
    font-family: var(--font-hand);
    font-size: 17px;
  }
  .draw {
    animation: dash 3s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -44;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .draw {
      animation: none;
    }
  }
</style>
